{
  "name": "@leovvay/refsure",
  "version": "0.1.0",
  "description": "Decision-backed browser judgment for AI agents driving Orca's embedded browser: locate, dismiss, state, outcome, wait-for.",
  "type": "module",
  "bin": {
    "refsure": "dist/refsure.mjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Vladyslav Leonchyk",
  "keywords": [
    "orca",
    "browser",
    "agents",
    "ai-agents",
    "decisions",
    "jev",
    "cli"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "scrub": "sh tools/scrub/scrub.sh",
    "prepublishOnly": "npm run typecheck && npm run build && npm run scrub"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
